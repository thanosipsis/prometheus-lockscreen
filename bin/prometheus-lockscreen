#!/usr/bin/env bash

set -euo pipefail

CONFIG_NAME="${PROMETHEUS_LOCKSCREEN_CONFIG_NAME:-prometheus-lockscreen}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
FEATURES_FILE="${PROMETHEUS_LOCKSCREEN_FEATURES_FILE:-$CONFIG_HOME/quickshell/$CONFIG_NAME/features.conf}"

config_value() {
    local key="$1"
    local default="${2:-}"
    local value

    if [[ ! -r "$FEATURES_FILE" ]]; then
        printf '%s\n' "$default"
        return 0
    fi

    value="$(
        awk -F= -v key="$key" '
            /^[[:space:]]*(#|$)/ { next }
            {
                k=$1
                sub(/^[[:space:]]+/, "", k)
                sub(/[[:space:]]+$/, "", k)
                if (k == key) {
                    v=substr($0, index($0, "=") + 1)
                    sub(/[[:space:]]+#.*/, "", v)
                    sub(/^[[:space:]]+/, "", v)
                    sub(/[[:space:]]+$/, "", v)
                    print v
                }
            }
        ' "$FEATURES_FILE" | tail -n 1
    )"

    printf '%s\n' "${value:-$default}"
}

is_truthy() {
    case "${1,,}" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

mkdir -p "$CACHE_HOME"

export PROMETHEUS_LOCKSCREEN_TARGET_SCREEN="${PROMETHEUS_LOCKSCREEN_TARGET_SCREEN:-$(config_value target_screen "")}"
export PROMETHEUS_LOCKSCREEN_PAM_DIR="${PROMETHEUS_LOCKSCREEN_PAM_DIR:-$(config_value pam_dir /etc/pam.d)}"
export PROMETHEUS_LOCKSCREEN_PAM_CONFIG="${PROMETHEUS_LOCKSCREEN_PAM_CONFIG:-$(config_value pam_config prometheus-lockscreen)}"
export PROMETHEUS_LOCKSCREEN_FACE_PAM_CONFIG="${PROMETHEUS_LOCKSCREEN_FACE_PAM_CONFIG:-$(config_value face_pam_config prometheus-lockscreen-face)}"
export PROMETHEUS_LOCKSCREEN_FACE_TRIGGER_FILE="${PROMETHEUS_LOCKSCREEN_FACE_TRIGGER_FILE:-$CACHE_HOME/prometheus-lockscreen-face-trigger}"
export PROMETHEUS_LOCKSCREEN_POWER_BUTTONS="${PROMETHEUS_LOCKSCREEN_POWER_BUTTONS:-$(config_value power_buttons 1)}"
export PROMETHEUS_LOCKSCREEN_BURN_IN="${PROMETHEUS_LOCKSCREEN_BURN_IN:-$(config_value burn_in 1)}"
export PROMETHEUS_LOCKSCREEN_BURN_IN_SHIFT_PIXELS="${PROMETHEUS_LOCKSCREEN_BURN_IN_SHIFT_PIXELS:-$(config_value burn_in_shift_pixels 4)}"
export PROMETHEUS_LOCKSCREEN_BURN_IN_INTERVAL_SECONDS="${PROMETHEUS_LOCKSCREEN_BURN_IN_INTERVAL_SECONDS:-$(config_value burn_in_interval_seconds 45)}"
export PROMETHEUS_LOCKCTL="${PROMETHEUS_LOCKCTL:-$HOME/.local/bin/prometheus-lockctl}"

face_auth="$(config_value face_auth 0)"
export PROMETHEUS_LOCKSCREEN_FACE_AUTH=0
if is_truthy "$face_auth" \
    && [[ -r /usr/lib/security/howdy/pam.py ]] \
    && [[ -r /usr/lib/security/pam_python3.so || -x /usr/lib/security/pam_python3.so ]]; then
    export PROMETHEUS_LOCKSCREEN_FACE_AUTH=1
fi

exec quickshell --config "$CONFIG_NAME" --no-duplicate "$@"
