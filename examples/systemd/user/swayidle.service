[Unit]
Description=Swayidle idle daemon for Prometheus lockscreen on Hyprland
Documentation=man:swayidle(1)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/share/prometheus-lockscreen/scripts/swayidle-session.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
